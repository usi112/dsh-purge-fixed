{
  "name": "local-purge-ui",
  "version": "0.2.0",
  "private": true,
  "description": "在 dsh-go 原生界面里操作 dsh-purge：输入框上方的「清洗」胶囊 + 面板（看补丁状态、一键应用 / 还原）。只在本机引擎里读写 dsh-purge 的补丁与状态文件，不联网。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "清洗",
      "en": "Purge"
    },
    "icon": "wrench",
    "contributes": {
      "composer.actions": [
        {
          "id": "purge-open",
          "label": {
            "zh": "清洗",
            "en": "Purge"
          },
          "icon": "wrench"
        }
      ],
      "composer.strip": [
        {
          "id": "purge-strip",
          "icon": "wrench",
          "text": {
            "zh": "清洗",
            "en": "Purge"
          },
          "panel": "purge-panel"
        }
      ],
      "panels": [
        {
          "id": "purge-panel",
          "title": {
            "zh": "dsh-purge 清洗",
            "en": "dsh-purge"
          },
          "icon": "wrench",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        }
      ]
    },
    "minApp": "1.0.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usi112/dsh-purge-fixed.git",
    "directory": "native-ui/local-purge-ui"
  },
  "keywords": [
    "dsh-go",
    "dsh-go-plugin"
  ]
}
